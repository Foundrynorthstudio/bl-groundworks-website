---
import Logo from './Logo.astro';
import { business } from '../data/site';
import { services } from '../data/services';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/portfolio', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Prices' },
  { href: '/areas', label: 'Areas' },
  { href: '/about', label: 'About' },
];

function current(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-ink text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="shrink-0" aria-label="BL Groundworks Scotland, home">
      <Logo compact />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['text-sm font-semibold tracking-wide', current(link.href) ? 'text-lime' : 'text-white/90 hover:text-lime']}
          aria-current={current(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={business.telephoneHref} class="text-sm font-semibold tracking-wide text-white hover:text-lime">
        {business.telephoneDisplay}
      </a>
      <a href="/contact" class="bg-lime px-4 py-2 text-sm font-bold tracking-wide text-ink">
        Free quote
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none px-3 py-2 text-sm font-bold tracking-wide text-lime [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <nav class="absolute right-0 mt-2 w-64 border border-white/10 bg-ink p-3" aria-label="Mobile">
        {links.map((link) => (
          <a href={link.href} class="block px-2 py-2 text-sm font-semibold text-white hover:text-lime">
            {link.label}
          </a>
        ))}
        <a href="/contact" class="mt-2 block bg-lime px-2 py-2 text-center text-sm font-bold text-ink">Free quote</a>
        <p class="mt-3 px-2 text-xs uppercase tracking-widest text-white/50">Services</p>
        {services.map((service) => (
          <a href={`/services/${service.slug}`} class="block px-2 py-1.5 text-sm text-white/80 hover:text-lime">
            {service.name}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
