---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getService, services } from '../../data/services';
import { getPackage, gbp } from '../../data/pricing';
import { coverImage, getProjects } from '../../lib/portfolio';
import { business } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug ?? '');
if (!service) {
  throw new Error('Missing service');
}

const price = getPackage(service.priceId);
const related = getProjects().filter((project) => project.services.includes(service.slug));
const others = services.filter((item) => item.slug !== service.slug).slice(0, 4);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];

const serviceLd = {
  '@type': 'Service',
  name: service.name,
  description: service.description,
  url: `${business.url}/services/${service.slug}`,
  provider: { '@id': `${business.url}/#business` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Clackmannanshire' },
  ...(price
    ? {
        offers: {
          '@type': 'Offer',
          name: `Example guide: ${price.name}`,
          description: 'Example guide only. The quoted price is confirmed after a site visit.',
          priceCurrency: 'GBP',
          price: String(price.from),
        },
      }
    : {}),
};
---

<Layout title={service.title} description={service.description} breadcrumbs={crumbs} extraJsonLd={[serviceLd]}>
  <article class="mx-auto max-w-6xl px-4 py-14">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-deep">Alloa and Clackmannanshire</p>
    <h1 class="mt-2 max-w-3xl font-display text-6xl font-semibold leading-none tracking-wide">{service.name}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{service.lead}</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="font-display text-3xl font-semibold tracking-wide">What the job includes</h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed">
          {service.includes.map((item) => (
            <li class="border border-line bg-white px-4 py-3">{item}</li>
          ))}
        </ul>
        <div class="mt-6 space-y-3 text-sm leading-relaxed text-muted">
          {service.notes.map((note) => <p>{note}</p>)}
        </div>
      </div>
      <aside class="border border-line bg-white p-5 lg:col-span-5">
        {price && (
          <>
            <p class="text-xs font-semibold uppercase tracking-widest text-lime-deep">Example guide</p>
            <p class="mt-2 font-display text-4xl font-semibold">From {gbp(price.from)}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{price.summary}</p>
            <a href="/pricing" class="mt-4 inline-block text-sm font-bold text-lime-deep underline">See the assumptions</a>
          </>
        )}
        <a href="/contact" class="mt-6 block bg-lime px-4 py-3 text-center text-sm font-bold text-ink">Ask for a quote</a>
        <a href={business.telephoneHref} class="mt-3 block text-center text-sm font-bold">{business.telephoneDisplay}</a>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="font-display text-4xl font-semibold tracking-wide">Related work</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">
          {related.map((project) => {
            const image = coverImage(project);
            return (
              <li class="border border-line bg-white">
                <a href={`/portfolio/${project.slug}`} class="block">
                  {image && <Image src={image.src} alt={image.alt} class="aspect-[2/1] w-full object-cover" widths={[480, 800]} sizes="(min-width: 768px) 50vw, 100vw" />}
                  <span class="block px-4 py-3 font-display text-2xl font-semibold tracking-wide">{project.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="mt-14">
      <h2 class="font-display text-3xl font-semibold tracking-wide">Other work</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {others.map((item) => (
          <li><a class="inline-block border border-line bg-white px-3 py-2 text-sm font-semibold" href={`/services/${item.slug}`}>{item.name}</a></li>
        ))}
      </ul>
    </section>
  </article>
</Layout>
