---
import Layout from '../../layouts/Layout.astro';
import { areas, getArea } from '../../data/areas';
import { services } from '../../data/services';
import { business } from '../../data/site';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug } }));
}

const area = getArea(Astro.params.slug ?? '');
if (!area) throw new Error('Missing area');

const nearby = areas.filter((item) => item.slug !== area.slug).slice(0, 4);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas', path: '/areas' },
  { name: area.name, path: `/areas/${area.slug}` },
];

const placeLd = {
  '@type': 'Service',
  name: `Landscaping and groundworks in ${area.name}`,
  description: area.description,
  areaServed: { '@type': 'City', name: area.name },
  provider: { '@id': `${business.url}/#business` },
  url: `${business.url}/areas/${area.slug}`,
};
---

<Layout title={area.title} description={area.description} breadcrumbs={crumbs} extraJsonLd={[placeLd]}>
  <article class="mx-auto max-w-6xl px-4 py-14">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-deep">From the Alloa base</p>
    <h1 class="mt-2 max-w-3xl font-display text-6xl font-semibold leading-none tracking-wide">Landscaping and groundworks in {area.name}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{area.lead}</p>
    <div class="mt-6 max-w-2xl space-y-4 text-base leading-relaxed">
      {area.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <h2 class="mt-10 font-display text-3xl font-semibold tracking-wide">Typical jobs in {area.name}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {area.typical.map((label) => {
        const service = services.find((item) => item.name.startsWith(label.split(' ')[0]) || label.startsWith(item.name.split(' ')[0]));
        const href = service ? `/services/${service.slug}` : '/services';
        return (
          <li><a class="inline-block border border-line bg-white px-3 py-2 text-sm font-semibold" href={href}>{label}</a></li>
        );
      })}
    </ul>

    <p class="mt-10">
      <a href="/contact" class="bg-lime px-5 py-3 text-sm font-bold text-ink">Quote for a {area.name} job</a>
    </p>

    <h2 class="mt-14 font-display text-3xl font-semibold tracking-wide">Nearby</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {nearby.map((item) => (
        <li><a class="inline-block border border-line bg-white px-3 py-2 text-sm font-semibold" href={`/areas/${item.slug}`}>{item.name}</a></li>
      ))}
    </ul>
  </article>
</Layout>
