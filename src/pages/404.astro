---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | BL Groundworks Scotland" description="That page is not on blgroundworks.com." noindex>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-6xl font-semibold tracking-wide">That page is not here.</h1>
    <p class="mt-4 text-muted">Try the work, the services, or a quote.</p>
    <ul class="mt-6 space-y-2 text-sm font-semibold">
      <li><a class="underline" href="/">Home</a></li>
      <li><a class="underline" href="/portfolio">Portfolio</a></li>
      <li><a class="underline" href="/pricing">Example prices</a></li>
      <li><a class="underline" href="/contact">Free quote</a></li>
    </ul>
  </section>
</Layout>
